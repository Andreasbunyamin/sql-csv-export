# =====================================================
#  Copy this file to .env and fill in the values.
#  NEVER commit or share a filled-in .env file.
#  An old .env (VERTICA_HOST, VERTICA_DB, ...) still works without changes.
# =====================================================

# ── Database ─────────────────────────────────────────
# postgres (default) or vertica. For Vertica, install with: setup.bat vertica
DB_TYPE=postgres

# ── Connection ───────────────────────────────────────
# The example values below match the demo database (docker compose up -d)
DB_HOST=localhost
# 5432 = PostgreSQL, 5433 = Vertica
DB_PORT=5432
DB_NAME=latihan
DB_USER=postgres
DB_PASSWORD=postgres
# Default schema for queries (may be left empty)
DB_SCHEMA=kaggle

# ── Timeouts & session ───────────────────────────────
# Seconds to wait for the server when connecting (VPN off -> fails fast)
DB_CONNECTION_TIMEOUT=30
# Maximum seconds to wait for a query result (0 = no limit)
DB_READ_TIMEOUT=900
DB_SESSION_LABEL=sql_csv_export

# ── TLS (only if the server requires it) ─────────────
# Options: disable | require | verify-ca | verify-full  (PostgreSQL also: allow, prefer)
DB_SSL_MODE=disable
# Path of the CA file, used for verify-ca / verify-full
DB_SSL_CA=

# ── Input & output ───────────────────────────────────
# A .sql file or a folder of .sql files. Relative paths start from this project folder
SQL_FILE=sql

# Output folder. Variables can be used so monthly folders are created automatically:
#   ${yyyy} ${MM} ${dd} ${monthName}
# Use single quotes because the path contains spaces.
# Windows example: OUTPUT_DIR='D:\Reports\${yyyy}\${MM}. ${monthName}'
OUTPUT_DIR='output/${yyyy}/${MM}. ${monthName}'

# File name pattern, same as DBeaver
#   ${scriptFilename} = .sql file name without extension
#   ${timestamp}      = export time, formatted with OUTPUT_TIMESTAMP_PATTERN
OUTPUT_FILE_PATTERN='${scriptFilename} (${timestamp})'
# Java/DBeaver-style date pattern (dd, MM, MMMM, yyyy, HH, mm, ss)
OUTPUT_TIMESTAMP_PATTERN=dd-MM-yyyy

# Output format: csv, xlsx, or csv,xlsx
OUTPUT_FORMATS=csv,xlsx
# autofix = add _1, _2 if the name already exists | overwrite = replace the file
OUTPUT_ON_CONFLICT=autofix

# ── CSV only ──
# utf-8 = same as DBeaver | utf-8-sig = UTF-8 + BOM (safer for Excel)
OUTPUT_ENCODING=utf-8
CSV_DELIMITER=,

# Number of rows fetched from the server per batch
FETCH_SIZE=10000
